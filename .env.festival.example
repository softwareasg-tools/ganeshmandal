# ==========================================================================
# Ganpati Festival Intelligence & Discovery Platform — Environment Variables
# ==========================================================================

# Server Port and Host
PORT=30000
HOST=0.0.0.0

# Admin Authentication Key (Required for POST / PUT / DELETE operations)
ADMIN_API_KEY=ganpati-admin-secret-2026

# Optional: External Mapbox or Google Maps Key (Default uses OpenStreetMap CartoDB keyless tiles)
MAPBOX_ACCESS_TOKEN=
GOOGLE_MAPS_API_KEY=

# Optional: Weather API Key (Default uses Open-Meteo keyless API)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# Telemetry and Simulation
CROWD_TELEMETRY_INTERVAL_MS=4000
PERSIST_TO_DISK=false
DATABASE_PATH=./data/festival_db.json

# Log level (info, debug, warn, error)
LOG_LEVEL=info
